# ── Variables de entorno para Estudio Kids App ──────────────────────────────
# Copiá este archivo a ".env" para desarrollo local.
# En Railway/Render configuralas directamente en el panel de la plataforma.

# Puerto del servidor (Railway/Render lo setean automáticamente)
PORT=3000

# Entorno: "production" en el servidor, dejar vacío o "development" en local
NODE_ENV=development

# Clave secreta para firmar tokens JWT — CAMBIALA por una cadena larga y aleatoria
# Generá una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_larga_y_segura

# Directorio donde se guarda la base de datos SQLite
# En Railway/Render apuntá al mount path del volumen persistente, ej: /data
# En local dejá vacío (usa la carpeta del proyecto)
DATA_DIR=
